# Copy to .env (gitignored) and fill in. All of these are optional.

# Enables the LLM free-text fallback. Leave empty for keyword-only.
GROQ_API_KEY=

# Enables GET /export (send the same value as the X-Admin-Token header).
ADMIN_TOKEN=

# Production only: your frontend URL, to lock down CORS.
# FRONTEND_ORIGIN=https://gift-navigator.vercel.app
